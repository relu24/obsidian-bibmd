{
  "name": "obsidian-bibmd",
  "version": "0.1.6",
  "description": "bibmd's bib blocks in Obsidian: each block drawn by bibmd itself, with bibui on .NET WebAssembly.",
  "type": "module",
  "private": true,
  "scripts": {
    "wasm": "wasm/build.sh",
    "package": "node wasm/package.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
